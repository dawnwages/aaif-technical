---
// The aaif.io footer, captured from the live site (see aaif-capture/README.md),
// with Technical Notes and Skills Catalog added to its Resources column.
import footer from '../aaif/footer.html?raw';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Fragment set:html={footer.replaceAll('__BASE__', base)} />
