---
// A skill card in the layout of aaif.io's blog cards.
import type { CollectionEntry } from 'astro:content';
import Pill from './Pill.astro';
import { skillStatuses } from '../data/working-groups';
import { url } from '../lib/url';
interface Props { skill: CollectionEntry<'skills'>; }
const { skill } = Astro.props;
const d = skill.data;
const chip = 'h-7 flex items-center justify-center px-2 py-1 bg-neutral-50 border border-neutral-200 text-black text-body-sm rounded-lg shrink-0 whitespace-nowrap';
---
<div data-status={d.status}>
  <article class="group flex flex-col h-full">
    <div class="flex flex-col gap-y-3 p-4 bg-white rounded-lg border border-neutral-200 flex-1">
      <div class="flex items-center gap-2 text-body-sm text-text">
        <Pill left={skillStatuses[d.status].name} right={d.license} accent={d.status !== 'listed'} />
        {d.executable && <><div class="w-1 h-1 bg-text rounded-full shrink-0"></div><div class={chip}>Runs scripts</div></>}
        {d.example && <><div class="w-1 h-1 bg-text rounded-full shrink-0"></div><div class={chip}>Example</div></>}
      </div>
      <a class="hover:underline" href={url(`/skills/${skill.id}/`)}><h6 class="text-h6 font-normal text-neutral-500 line-clamp-3">{d.name}</h6></a>
      <p class="text-body-sm text-text line-clamp-2">{d.description}</p>
      <div class="mt-auto pt-1 flex items-center gap-2 text-body-xs text-black">
        <span class="font-medium">{d.maintainer.name} ({d.maintainer.org})</span>
        <div class="w-1 h-1 bg-text rounded-full shrink-0"></div>
        <span class="shrink-0">v{d.version}</span>
      </div>
    </div>
  </article>
</div>
