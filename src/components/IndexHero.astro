---
// The hero from aaif.io/blog: soft background, white card, eyebrow and large title.
interface Props { eyebrow: string; title: string; }
const { eyebrow, title } = Astro.props;
---
<section class="w-full bg-white relative overflow-hidden">
  <img alt="" decoding="async" class="object-cover bg-asset" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" src="https://aaif.io/_next/image?url=%2Fassets%2Fcommon-hero-bg.webp&w=3840&q=75" />
  <div class="section-container relative z-1 pt-[calc(var(--nav-h,100px)+40px)] pb-10 lg:pt-[calc(var(--nav-h,100px)+84px)] lg:pb-21">
    <div class="bg-white px-4 py-10 md:px-10 lg:py-16 border border-gray-200 rounded-2xl flex flex-col gap-y-10 lg:gap-y-16">
      <header class="flex flex-col gap-y-2">
        <div class="hero-reveal text-body-sm text-black uppercase font-semibold">{eyebrow}</div>
        <div class="hero-reveal"><h1 class="max-lg:text-h2 text-hero font-normal text-black">{title}</h1></div>
      </header>
      <slot />
    </div>
  </div>
</section>
