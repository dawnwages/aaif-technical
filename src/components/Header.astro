---
// Matches the aaif.io header: logo, About AAIF, Projects, Events, Resources, Join AAIF.
// To use the exact aaif.io component instead, replace this file and keep src/data/site.ts as its data.
import { logo, nav, cta } from '../data/site';
import { link } from '../lib/url';
const current = Astro.url.pathname;
---
<header class="site-header">
  <div class="container bar">
    <a class="logo" href={logo.href}><img src={logo.src} alt={logo.alt} width="166" height="40" /></a>

    <nav class="primary" aria-label="Main">
      <ul>
        {nav.map((item) => item.children ? (
          <li class="has-menu">
            <details>
              <summary>{item.label}<span aria-hidden="true" class="caret"></span></summary>
              <ul class="menu">
                {item.children.map((c) => {
                  const href = link(c.href, c.internal);
                  return <li><a href={href} aria-current={c.internal && current.startsWith(href) ? 'page' : undefined}>{c.label}</a></li>;
                })}
              </ul>
            </details>
          </li>
        ) : (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <a class="btn btn-coral cta" href={cta.href}>{cta.label}</a>

    <details class="mobile">
      <summary aria-label="Open menu"><span></span><span></span><span></span></summary>
      <div class="mobile-panel">
        <ul>
          {nav.flatMap((item) => item.children
            ? [<li class="group">{item.label}</li>, ...item.children.map((c) => <li><a href={link(c.href, c.internal)}>{c.label}</a></li>)]
            : [<li><a href={item.href}>{item.label}</a></li>])}
        </ul>
        <a class="btn btn-coral" href={cta.href}>{cta.label}</a>
      </div>
    </details>
  </div>
</header>

<script>
  // Close an open dropdown when clicking elsewhere or pressing Escape.
  document.addEventListener('click', (e) => {
    document.querySelectorAll<HTMLDetailsElement>('.site-header details[open]').forEach((d) => {
      if (!d.contains(e.target as Node)) d.open = false;
    });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') document.querySelectorAll<HTMLDetailsElement>('.site-header details[open]').forEach((d) => (d.open = false));
  });
</script>

<style>
  .site-header { background: var(--aaif-header-bg); color: var(--aaif-header-ink); position: sticky; top: 0; z-index: 50; }
  .bar { display: flex; align-items: center; gap: var(--space-4); min-height: 76px; }
  .logo img { height: 40px; width: auto; }
  .logo { display: inline-flex; flex-shrink: 0; }
  .primary { margin-left: auto; }
  .primary > ul { display: flex; gap: var(--space-4); list-style: none; margin: 0; padding: 0; align-items: center; }
  .primary a, .primary summary { color: inherit; text-decoration: none; font-weight: 500; font-size: var(--step-0); cursor: pointer; }
  .primary a:hover, .primary summary:hover { color: var(--aaif-coral); }
  summary { list-style: none; display: inline-flex; align-items: center; gap: 0.4rem; }
  summary::-webkit-details-marker { display: none; }
  .caret { width: 0.45rem; height: 0.45rem; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: rotate(45deg) translateY(-2px); }
  details[open] .caret { transform: rotate(-135deg) translateY(-1px); }
  .has-menu { position: relative; }
  .menu {
    position: absolute; top: calc(100% + 18px); left: -1rem; min-width: 220px; list-style: none; margin: 0; padding: 0.5rem;
    background: var(--aaif-black); border: 1px solid #2a2a2e; border-radius: var(--radius);
  }
  .menu a { display: block; padding: 0.55rem 0.75rem; border-radius: 8px; }
  .menu a:hover, .menu a[aria-current='page'] { background: #1a1a1d; color: var(--aaif-coral); }
  .cta { flex-shrink: 0; }
  .mobile { display: none; margin-left: auto; }
  .mobile summary { display: inline-flex; flex-direction: column; gap: 5px; padding: 0.5rem; cursor: pointer; }
  .mobile summary span { display: block; width: 22px; height: 2px; background: currentColor; }
  .mobile-panel {
    position: absolute; left: 0; right: 0; top: 100%; background: var(--aaif-black);
    padding: var(--space-2) var(--gutter) var(--space-4); border-top: 1px solid #2a2a2e;
  }
  .mobile-panel ul { list-style: none; margin: 0 0 var(--space-3); padding: 0; }
  .mobile-panel li a { display: block; padding: 0.6rem 0; color: inherit; text-decoration: none; font-size: var(--step-1); }
  .mobile-panel li.group { margin-top: var(--space-2); font-size: var(--step--1); text-transform: uppercase; letter-spacing: 0.08em; color: var(--aaif-footer-muted); }
  @media (max-width: 960px) {
    .primary, .cta { display: none; }
    .mobile { display: block; }
  }
</style>
