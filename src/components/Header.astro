---
// The aaif.io header, captured from the live site (see aaif-capture/README.md).
// The markup and classes are aaif.io's own; this file only adds the behavior
// that aaif.io's React code provides: dropdowns, the mobile menu, and --nav-h.
import header from '../aaif/header.html?raw';
import panelAbout from '../aaif/panel-about.html?raw';
import panelResources from '../aaif/panel-resources.html?raw';
import mobileMenu from '../aaif/mobile-menu.html?raw';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (html: string) => html.replaceAll('__BASE__', base);
---
<Fragment set:html={header} />
<template id="aaif-panel-about-aaif" set:html={panelAbout}></template>
<template id="aaif-panel-resources" set:html={withBase(panelResources)}></template>
<template id="aaif-mobile-menu" set:html={mobileMenu}></template>

<script>
  const bar = document.querySelector<HTMLElement>('body > div.fixed.top-0');
  const header = bar?.querySelector('header');
  const nav = header?.querySelector<HTMLElement>('nav[data-nav-dropdown]');

  // aaif.io sets --nav-h to the header's height; page sections use it for top padding.
  const setNavH = () => bar && document.documentElement.style.setProperty('--nav-h', `${bar.offsetHeight}px`);
  setNavH();
  window.addEventListener('resize', setNavH);
  if (bar && 'ResizeObserver' in window) new ResizeObserver(setNavH).observe(bar);

  const slug = (s: string) => s.trim().toLowerCase().replace(/[^a-z0-9]+/g, '-');
  const panelFor = (label: string) => document.querySelector<HTMLTemplateElement>(`#aaif-panel-${slug(label)}`);

  // Mark the current page in the menus, the way aaif.io does.
  const markCurrent = (root: ParentNode) => {
    root.querySelectorAll<HTMLAnchorElement>('a[href]').forEach((a) => {
      if (a.host === location.host && a.pathname.length > 1 && location.pathname.startsWith(a.pathname)) {
        a.setAttribute('aria-current', 'page');
        a.classList.replace('text-neutral-500', 'text-coral-500');
      }
    });
  };

  // Desktop dropdowns
  let openBtn: HTMLButtonElement | null = null;
  let openPanel: HTMLElement | null = null;
  const close = () => {
    if (!openBtn) return;
    openBtn.setAttribute('aria-expanded', 'false');
    openBtn.classList.replace('text-coral-500', 'text-text');
    openPanel?.remove();
    openBtn = openPanel = null;
  };
  nav?.querySelectorAll<HTMLButtonElement>('button[aria-haspopup]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const same = openBtn === btn;
      close();
      if (same) return;
      const tpl = panelFor(btn.textContent ?? '');
      if (!tpl) return;
      const el = tpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
      el.style.opacity = '0';
      el.style.transform = 'scale(0.96) rotateX(-20deg)';
      el.style.transition = 'opacity .2s ease, transform .2s ease';
      el.style.transformOrigin = 'top center';
      nav.appendChild(el);
      markCurrent(el);
      requestAnimationFrame(() => { el.style.opacity = '1'; el.style.transform = 'none'; });
      btn.setAttribute('aria-expanded', 'true');
      btn.classList.replace('text-text', 'text-coral-500');
      openBtn = btn;
      openPanel = el;
    });
  });
  document.addEventListener('click', (e) => { if (openPanel && !openPanel.contains(e.target as Node)) close(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { close(); closeMobile(); } });

  // Mobile menu
  const burger = header?.querySelector<HTMLButtonElement>('button[aria-label="Open menu"]');
  const lines = burger ? [...burger.querySelectorAll<HTMLElement>(':scope > span > span')] : [];
  const openLines = ['translate-x-0.5 translate-y-0.5 rotate-45', '-rotate-45', '-translate-x-0.5 -translate-y-0.5 rotate-45'];
  let mobileNodes: Element[] = [];
  const closeMobile = () => {
    if (!burger || !mobileNodes.length) return;
    mobileNodes.forEach((n) => n.remove());
    mobileNodes = [];
    burger.setAttribute('aria-expanded', 'false');
    burger.setAttribute('aria-label', 'Open menu');
    lines.forEach((l, i) => l.classList.remove(...openLines[i].split(' ')));
    document.body.style.overflow = '';
  };
  const openMobile = () => {
    const tpl = document.querySelector<HTMLTemplateElement>('#aaif-mobile-menu');
    const container = header?.firstElementChild;
    const card = container?.firstElementChild;
    if (!burger || !tpl || !container || !card) return;
    const frag = tpl.content.cloneNode(true) as DocumentFragment;
    mobileNodes = [...frag.children];
    card.after(frag);
    burger.setAttribute('aria-expanded', 'true');
    burger.setAttribute('aria-label', 'Close menu');
    lines.forEach((l, i) => l.classList.add(...openLines[i].split(' ')));
    document.body.style.overflow = 'hidden';
    const list = container.querySelector<HTMLUListElement>('section ul');
    if (!list) return;
    const top = list.innerHTML;
    const linkClass = 'block text-body-md font-semibold hover:text-coral-500 transition-colors text-neutral-500';
    const bind = () => {
      markCurrent(list);
      list.querySelectorAll<HTMLButtonElement>(':scope > li > button').forEach((b) => {
        b.addEventListener('click', () => {
          const name = b.querySelector('span')?.textContent ?? '';
          const panel = panelFor(name);
          if (!panel) return;
          const links = [...panel.content.querySelectorAll<HTMLAnchorElement>('a[role="menuitem"]')];
          list.innerHTML =
            `<li><button type="button" class="w-full flex items-center justify-between font-semibold hover:text-coral-500 transition-colors cursor-pointer text-neutral-500" data-back><span class="text-body-md">&larr; ${name.trim()}</span></button></li>` +
            links.map((a) => `<li><a class="${linkClass}" href="${a.getAttribute('href')}"${a.target ? ` target="${a.target}" rel="noopener noreferrer"` : ''}>${a.textContent?.trim()}</a></li>`).join('');
          markCurrent(list);
          list.querySelector('[data-back]')?.addEventListener('click', () => { list.innerHTML = top; bind(); });
        });
      });
    };
    bind();
  };
  burger?.addEventListener('click', () => (mobileNodes.length ? closeMobile() : openMobile()));
  window.addEventListener('resize', () => { if (window.innerWidth >= 1024) closeMobile(); });
</script>
