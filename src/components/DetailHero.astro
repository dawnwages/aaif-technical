---
// The hero from an aaif.io blog post: dark rounded card, breadcrumb, title, byline.
interface Props { crumbs: { label: string; href: string }[]; title: string; }
const { crumbs, title } = Astro.props;
---
<section class="w-full bg-white">
  <div class="section-container pt-[calc(var(--nav-h,100px)+40px)] pb-10 bg-white">
    <div class="relative w-full sm:aspect-16/7 rounded-2xl overflow-hidden border border-neutral-200 bg-black xl:min-h-110 max-sm:min-h-60">
      <div class="absolute inset-0 bg-black/90"></div>
      <div class="relative grid place-items-center px-6 py-10 min-h-full">
        <div class="flex flex-col items-center gap-y-2 text-center">
          <div class="hero-reveal">
            <nav aria-label="Breadcrumb" class="flex items-center gap-x-2 text-body-sm text-neutral-300">
              {crumbs.map((c, i) => (
                <span class="flex items-center gap-x-2">
                  <a class={i === 0 ? 'underline underline-offset-2 hover:text-white' : 'underline-offset-2 hover:text-white hover:underline'} href={c.href}>{c.label}</a>
                  {i < crumbs.length - 1 && <span class="text-white/50">&gt;</span>}
                </span>
              ))}
            </nav>
          </div>
          <div class="hero-reveal"><h1 class="text-h4 lg:text-display font-normal text-white max-w-212.5">{title}</h1></div>
          <div class="hero-reveal flex items-center flex-wrap justify-center gap-x-3 gap-y-1 text-body-sm text-neutral-300 mt-5"><slot /></div>
        </div>
      </div>
    </div>
  </div>
</section>
