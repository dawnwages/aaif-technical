---
import '../aaif/aaif.css';
import '../styles/site.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { url } from '../lib/url';

interface Props { title: string; description?: string; }
const { title, description = 'Technical notes and the skills catalog from the Agentic AI Foundation working groups.' } = Astro.props;
// Same title pattern as aaif.io: "Page - Agentic AI Foundation (AAIF)".
const fullTitle = `${title} - Agentic AI Foundation (AAIF)`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Prototype mode (the default) adds noindex and a visible label. Set PROTOTYPE=false when the site goes live on aaif.io.
const prototype = (import.meta.env.PROTOTYPE ?? process.env.PROTOTYPE ?? 'true') !== 'false';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {prototype && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Agentic AI Foundation (AAIF)" />
    <link rel="icon" href="https://aaif.io/favicon.ico" />
    <link rel="alternate" type="application/rss+xml" title="AAIF Technical Notes" href={url('/rss.xml')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="t-skip" href="#main">Skip to content</a>
    <Header />
    <main id="main" class="min-h-screen"><slot /></main>
    <Footer />
    {prototype && <p class="t-proto" role="note">Prototype for review. Not an official AAIF page.</p>}
  </body>
</html>
