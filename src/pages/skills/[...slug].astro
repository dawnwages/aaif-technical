---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import DetailHero from '../../components/DetailHero.astro';
import Pill from '../../components/Pill.astro';
import Button from '../../components/Button.astro';
import { skillStatuses, wgName } from '../../data/working-groups';
import { url, formatDate } from '../../lib/url';

export async function getStaticPaths() {
  const skills = await getCollection('skills');
  return skills.map((skill) => ({ params: { slug: skill.id }, props: { skill } }));
}

const { skill } = Astro.props;
const d = skill.data;
const status = skillStatuses[d.status];
---
<Base title={d.name} description={d.description}>
  <DetailHero title={d.name} crumbs={[{ label: 'Skills Catalog', href: url('/skills/') }]}>
    <span>{d.maintainer.name} ({d.maintainer.org})</span>
    <div class="w-1 h-1 bg-neutral-300 rounded-full shrink-0"></div>
    <span>v{d.version}</span>
  </DetailHero>

  <div class="section-container pb-16">
    <div class="flex justify-center">
      <article class="w-full max-w-205 mx-auto lg:mx-0 lg:pt-16 pt-6 flex flex-col gap-y-10">
        <p class="text-body-md text-text">{d.description}</p>
        <div class="w-full flex flex-col gap-6 rounded-2xl border border-neutral-200 bg-white px-4 py-6 lg:px-10 lg:py-8">
          <div class="flex items-center gap-2 text-body-sm text-text">
            <Pill left={status.name} right={d.license} accent={d.status !== 'listed'} />
          </div>
          <dl class="t-facts text-body-sm">
            <dt>Review status</dt><dd>{status.help}{d.reviewedBy && <> ({wgName(d.reviewedBy)})</>}</dd>
            <dt>Source</dt><dd><a class="hover:underline text-coral-500" href={d.source}>{d.source}</a>{d.path && <> · {d.path}</>}</dd>
            <dt>Version</dt><dd>{d.version}</dd>
            <dt>License</dt><dd>{d.license}</dd>
            <dt>Maintainer</dt><dd>{d.maintainer.name} ({d.maintainer.org}){d.maintainer.github && <> · <a class="hover:underline text-coral-500" href={`https://github.com/${d.maintainer.github}`}>@{d.maintainer.github}</a></>}</dd>
            <dt>Runs scripts</dt><dd>{d.executable ? 'Yes. Read the scripts before you run this skill.' : 'No'}</dd>
            <dt>Added</dt><dd>{formatDate(d.added)}</dd>
          </dl>
        </div>
        <div class="flex flex-wrap items-center gap-x-4 gap-y-6">
          <Button href={d.source} external>View source</Button>
          <Button href="https://github.com/aaif" external>Report a problem</Button>
        </div>
      </article>
    </div>
  </div>
</Base>
