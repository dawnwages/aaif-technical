---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import DetailHero from '../../components/DetailHero.astro';
import Pill from '../../components/Pill.astro';
import { noteLabels, wgName } from '../../data/working-groups';
import { url, formatDate } from '../../lib/url';

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => !data.draft);
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }));
}

const { note } = Astro.props;
const d = note.data;
const { Content } = await render(note);
const label = noteLabels[d.label];
---
<Base title={d.title} description={d.description}>
  <DetailHero
    title={d.title}
    crumbs={[{ label: 'Technical Notes', href: url('/notes/') }, { label: wgName(d.wg), href: url(`/wg/${d.wg}/`) }]}
  >
    <span>{d.authors.map((a) => `${a.name} (${a.org})`).join(', ')}</span>
    <div class="w-1 h-1 bg-neutral-300 rounded-full shrink-0"></div>
    <span>{formatDate(d.published)}</span>
    {d.updated && <><div class="w-1 h-1 bg-neutral-300 rounded-full shrink-0"></div><span>Updated {formatDate(d.updated)}</span></>}
  </DetailHero>

  <div class="section-container pb-16">
    <div class="flex justify-center">
      <article class="w-full max-w-205 mx-auto lg:mx-0 lg:pt-16 pt-6 flex flex-col gap-y-10">
        <div class="w-full flex flex-col gap-6 rounded-2xl border border-neutral-200 bg-white px-4 py-6 lg:px-10 lg:py-8">
          <div class="flex items-center gap-2 text-body-sm text-text">
            <Pill left={label.name} right={wgName(d.wg)} accent={d.label === 'reviewed'} />
          </div>
          <p class="text-body-sm text-text">{label.help} <a class="hover:underline text-coral-500" href={d.source}>Source in the working group repository</a>{d.discussion && <> · <a class="hover:underline text-coral-500" href={d.discussion}>Join the discussion</a></>}</p>
        </div>
        <div class="prose dark:prose-invert prose prose-neutral max-w-none prose-headings:font-medium marker:text-coral-500 prose-headings:tracking-tight prose-a:text-coral-500 prose-a:no-underline prose-a:break-words hover:prose-a:underline">
          <Content />
        </div>
      </article>
    </div>
  </div>
</Base>
